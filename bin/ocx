#!/bin/sh
# Resolve symlinks to find the real install location
SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
OCX_CODE="$(cd "$(dirname "$SOURCE")/.." && pwd)"

subcmd="${1:-help}"
shift 2>/dev/null

case "$subcmd" in
  cron)
    cron_subcmd="${1:-help}"
    shift 2>/dev/null
    case "$cron_subcmd" in
      up)
        exec node "$OCX_CODE/dist/cron-up.js" "$@"
        ;;
      down)
        exec node "$OCX_CODE/dist/cron-down.js" "$@"
        ;;
      link)
        exec node "$OCX_CODE/dist/cron-link.js" "$@"
        ;;
      investigate)
        exec node "$OCX_CODE/dist/cron-investigate.js" "$@"
        ;;
      help|--help|-h)
        echo "⏰ ocx cron — Cron operations"
        echo ""
        echo "  ocx cron up <cron_id>                   Increase frequency one tier"
        echo "  ocx cron down <cron_id>                 Decrease frequency one tier"
        echo "  ocx cron link <follower> <source> <mult> Sync linked cron"
        echo "  ocx cron investigate --agent <id>       Investigate cron session history"
        ;;
      *)
        echo "Unknown cron subcommand: $cron_subcmd" >&2
        exit 1
        ;;
    esac
    ;;
  model)
    exec node "$OCX_CODE/dist/model-select.js" "$@"
    ;;
  saga)
    exec node "$OCX_CODE/dist/saga.js" "$@"
    ;;
  model-debug)
    exec node "$OCX_CODE/dist/model-debug.js" "$@"
    ;;
  doctor)
    exec node "$OCX_CODE/dist/doctor.js" "$@"
    ;;
  config)
    exec node "$OCX_CODE/dist/config.js" "$@"
    ;;
  help|--help|-h)
    echo "🦞 ocx — OpenClaw Extensions"
    echo ""
    echo "Usage: ocx <subcommand> [args]"
    echo ""
    echo "Subcommands:"
    echo "  cron         Cron frequency management (up/down/link)"
    echo "  model        Select OpenClaw-specific models for subagents and other helpers"
    echo "  saga         Staged prompt executor (start/submit/current/status/export)"
    echo "  model-debug  Diagnose model call failures for an agent/channel"
    echo "  doctor       Validate OpenClaw config (model refs, legacy values)"
    echo "  config       Merge/split OpenClaw config includes"
    ;;
  *)
    echo "Unknown subcommand: $subcmd" >&2
    exit 1
    ;;
esac
