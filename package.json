{
  "name": "openclaw-extensions",
  "version": "0.5.3",
  "description": "CLI utilities and plugin extensions for OpenClaw — prompt injections, model selection, cron frequency management, adaptive scheduling, and operational tools",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/exisz/openclaw-extensions"
  },
  "bin": {
    "ocx": "./bin/ocx"
  },
  "main": "./dist/openclaw-plugin.js",
  "types": "./dist/openclaw-plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/openclaw-plugin.d.ts",
      "import": "./dist/openclaw-plugin.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "injections",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "cli",
    "cron",
    "scheduling",
    "agent-framework"
  ],
  "engines": {
    "node": ">=18"
  },
  "openclaw": {
    "extensions": [
      "./dist/openclaw-plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.28"
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  }
}
